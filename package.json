{
  "name": "react-native-follow-up",
  "version": "0.1.0",
  "description": "Forced, localized gospel-invitation flow for React Native/Expo apps: shows after N app opens with a full-screen animated presentation.",
  "main": "lib/index.js",
  "module": "lib/index.mjs",
  "types": "lib/index.d.ts",
  "source": "src/index.ts",
  "sideEffects": false,
  "files": [
    "src",
    "lib",
    "!**/__tests__"
  ],
  "scripts": {
    "build": "tsup",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "check:imports": "node scripts/check-bundle-imports.js",
    "check:native": "node scripts/check-no-native.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "react-native",
    "expo",
    "gospel",
    "follow-up",
    "onboarding"
  ],
  "author": "Andro Nasef",
  "license": "MIT",
  "repository": "https://github.com/andronasef/followup-react-native",
  "peerDependencies": {
    "@react-native-async-storage/async-storage": ">=1.0.0",
    "expo-linking": "*",
    "expo-localization": "*",
    "react": "*",
    "react-native": "*",
    "react-native-reanimated": ">=3.0.0",
    "react-native-svg": ">=13.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@testing-library/react-native": "^12.5.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20",
    "@types/react": "^18.2.0",
    "babel-jest": "^29.7.0",
    "expo": "~51.0.0",
    "expo-linking": "~6.3.1",
    "expo-localization": "~15.0.3",
    "jest": "^29.7.0",
    "react": "18.2.0",
    "react-native": "0.74.5",
    "react-native-reanimated": "~3.10.1",
    "react-native-svg": "15.2.0",
    "react-test-renderer": "18.2.0",
    "ts-jest": "^29.1.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0"
  }
}
